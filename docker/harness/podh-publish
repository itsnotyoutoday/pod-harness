"""Push the job's outputs to durable storage, for mount kinds that do not do it implicitly.

## Why this exists

`ObjectMount.publish()` was written, correct, and called by nothing — the exact symmetry of
`prepare()`, which was also written, correct, and called by nothing until a run spent three
attempts failing on a manifest it had never fetched.

The consequence here is worse. A run completed all seven stages, reported `ok` for every
one, exited 0, and published **zero objects**. Every output sat in a scratch directory on
the container disk and was destroyed with the pod. Six minutes of successful compute
produced nothing that outlived the machine, and the status said `done`.

That is precisely the failure this project's verification framework exists to catch —
reported success over absent output — arriving through the one path that had no check.

## Why it is fatal when it publishes nothing

A job that ran stages and produced no outputs is either broken or pointless, and either way
the operator must be told at the time. Exiting quietly leaves a `done` job whose product
does not exist, which is discovered later — usually by someone looking for the results.

`allow_empty` exists for jobs that genuinely produce nothing durable (a probe, a
benchmark), and it has to be stated in the spec rather than inferred, because "produced
nothing" and "intended to produce nothing" look identical from here.

## Volume and FUSE

Nothing to do: the volume IS the durable store and outlives the pod. Only object mode has
to move bytes, which is why this is a step rather than a property of the mount.
"""
import json
import os
import pathlib
import sys

sys.path.insert(0, "/app")

from pod_harness.mount import for_spec, mount_roots


def main() -> int:
    path = os.environ.get("PODH_JOB_SPEC", "")
    if not path or not os.path.exists(path):
        print(f"  ! publish skipped — no readable spec at {path or '<unset>'}")
        return 0

    spec = json.load(open(path))
    kind = (spec.get("mount") or {}).get("kind") or os.environ.get("PODH_MOUNT_KIND", "")
    if kind != "object":
        print(f"  publish: nothing to do for mount kind {kind!r} — the mount is durable")
        return 0

    # Where the workload was TOLD to write, resolved the same way podh-roots resolved it,
    # so this cannot drift from what the job actually used.
    out_root = os.environ.get("PODH_OUT_ROOT") or os.environ.get("LINGUA_OUT_ROOT") or ""
    if not out_root:
        roots = mount_roots(spec)
        rel = roots.get("out_root")
        if not rel:
            print("  publish: the spec declares no out_root — nothing to publish")
            return 0
        scratch = os.environ.get("PODH_SCRATCH", "/workspace/scratch")
        out_root = rel if rel.startswith("/") else f"{scratch.rstrip('/')}/{rel}"

    # Every tree the layout defines, not just the run's out/.
    #
    # This published out_root alone, so assets/derived/ and assets/profiles/ were computed
    # on the pod and destroyed with it. That is why half the documented structure has
    # always been empty, and why every run recomputed normalize and align over inputs whose
    # results already existed.
    #
    # Each tree keeps its own key prefix because they have different retention: a run's
    # output is prunable by age, a derived artifact is expensive and reusable, a promoted
    # profile is pointed at by `current` and kept.
    # The job id names the run's output prefix. This was used and never defined — a
    # NameError that crashed publish before it uploaded anything, so a run whose seven
    # stages all passed lost its entire product and reported rc=1 with no visible reason.
    job = (spec.get("job_id") or os.environ.get("PODH_JOB_ID")
           or spec.get("idempotency_key") or "unknown")

    # The MOUNT root, not the workspace. With mount kind object the workload lives under
    # <workspace>/scratch/, so publishing <workspace>/assets would look at a directory the
    # job never wrote to — which is exactly how assets/derived stayed empty while the
    # stages were filling it in a sibling tree.
    #
    # corpus/ and assets/ and out/ are siblings under the mount root, so any one of them
    # locates the others.
    corpus_root = os.environ.get("PODH_CORPUS_ROOT") or os.environ.get("LINGUA_CORPUS_ROOT")
    if corpus_root:
        ws = str(pathlib.Path(corpus_root).parent)
    else:
        ws = str(pathlib.Path(out_root).parent) if out_root else \
             os.environ.get("PODH_WORKSPACE", "/workspace").rstrip("/")
    # (local, key_prefix, skip_existing)
    #
    # corpus/raw is skip_existing because acquire DOWNLOADS into it, and without publishing
    # that back the download dies with the pod — one 2,142 MB source was measured arriving
    # at 0.05 MB/s from its origin. But the tree already holds 11 GB, so re-uploading it
    # every run would cost far more than it saves. Only what the store lacks is sent.
    trees = [
        (out_root, f"runs/{job}/out", False),
        (f"{ws}/assets/derived", "assets/derived", False),
        (f"{ws}/assets/profiles", "assets/profiles", False),
        (corpus_root and f"{corpus_root}/raw" or f"{ws}/corpus/raw", "corpus/raw", True),
    ]

    m = for_spec(spec)
    published = skipped = 0
    total_files = total_bytes = 0
    failures = []
    for local, prefix, skip in trees:
        r = m.publish_tree(local, prefix, skip_existing=skip)
        if r.get("published"):
            published += 1
            total_files += r.get("files", 0)
            total_bytes += r.get("bytes", 0)
            extra = f"  ({r['skipped']} already present)" if r.get("skipped") else ""
            print(f"  publish: {r['files']:>5} file(s) {r['bytes']/1e6:>8.1f} MB  "
                  f"{local} → {prefix}{extra}")
        elif r.get("skipped"):
            skipped += 1
            print(f"  publish: {r['skipped']:<7} {local}")
        else:
            failures.append(f"{local}: {r.get('error', 'failed')}")

    if failures:
        for f in failures:
            print(f"  ✗ publish: {f}")
        return 1

    allow_empty = bool((spec.get("mount") or {}).get("allow_empty_output"))
    if total_files == 0 and not allow_empty:
        print("  ✗ publish: the job completed and produced NO output files anywhere.")
        print("    Every stage reported ok over empty output trees, which is the failure")
        print("    this framework exists to catch. If this job is genuinely not meant to")
        print("    produce anything, set mount.allow_empty_output=true.")
        return 1

    print(f"  publish: {total_files} file(s), {total_bytes/1e6:.1f} MB across "
          f"{published} tree(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
