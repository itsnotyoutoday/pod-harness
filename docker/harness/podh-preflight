#!/usr/bin/env bash
# podh-preflight — one block of diagnostic state at job start.
#
# Reports what is ACTUALLY present rather than a fixed list of one workload's tools. This
# printed ffmpeg and MFA and LINGUA_* paths inside a slim image that contains none of
# them, which is confusing at best — and at worst tells you a lightweight container is
# dragging a linguistics stack around. It is not; the report was.
#
# Sits at the top of every job log so "why was this slow" and "did it get the right inputs"
# are answerable without re-running anything. The expensive version of this question is a
# second pod-hour; the cheap version is thirty lines of shell.
#
# Adapted from plexus-preflight, with the checks that matter for THIS pipeline:
#   - optional tooling, reported only when present, because a slim image legitimately
#     has none of it and "MISSING" implies breakage
#     segmental rule reports UNTESTED — the exact failure Dockerfile.pod was written to fix
#   - whether the baked models actually resolved, since a mount can shadow them
#   - GPU, when present, so the same script serves the CPU and GPU images unchanged
#
# Prints no secrets. Values are truncated rather than omitted so the shape of a
# misconfiguration is still visible.
set -u

echo "================================================================================"
echo "  ${PODH_IMAGE_KIND:-pod} harness preflight"
echo "================================================================================"

echo "[identity]"
echo "  pod_id:      ${RUNPOD_POD_ID:-unset}"
echo "  job_id:      ${PODH_JOB_ID:-unset}"
echo "  image:       ${PODH_IMAGE:-$(cat /etc/hostname 2>/dev/null || echo unknown)}"
echo "  runpodctl:   $(runpodctl version 2>/dev/null | head -1 || echo 'not installed')"

echo
echo "[clock]"
echo "  utc:         $(date -u '+%Y-%m-%d %H:%M:%S %Z')"

echo
echo "[hardware]"
echo "  cpus:        $(nproc 2>/dev/null || echo '?')"
echo "  mem_total:   $(free -h 2>/dev/null | awk '/Mem:/ {print $2}' || echo '?')"
echo "  mem_avail:   $(free -h 2>/dev/null | awk '/Mem:/ {print $7}' || echo '?')"
echo "  disk /workspace: $(df -h /workspace 2>/dev/null | tail -1 | awk '{print $4" free of "$2}' || echo 'not mounted')"
echo "  disk /:      $(df -h / 2>/dev/null | tail -1 | awk '{print $4" free of "$2}')"
if command -v nvidia-smi >/dev/null 2>&1; then
    echo "  gpu:         $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | head -1 || echo 'nvidia-smi failed')"
else
    echo "  gpu:         none (CPU image)"
fi

echo
echo "[audio toolchain]"
# Optional tooling: reported when present, silent when not. A slim image legitimately has
# none of this, and listing it as MISSING implies something is broken.
for t in ffmpeg ffprobe mfa; do
    if command -v "$t" >/dev/null 2>&1; then
        echo "  $t: $("$t" -version 2>/dev/null | head -1 | cut -c1-60)"
    fi
done
echo "  ffprobe:     $(command -v ffprobe >/dev/null 2>&1 && echo present || echo MISSING)"
# Model directories, reported only when the image was told it has some. Which models,
# and what their absence means, is the workload's business — a harness announcing that
# "alignment will SKIP and segmental rules report UNTESTED" is a harness that only serves
# one pipeline. The same finding as mount.py hardcoding corpus/: imports were clean, the
# coupling was in strings.
if [ -n "${PODH_MODEL_ROOT:-}" ] && [ -d "${PODH_MODEL_ROOT}" ]; then
    echo "  models: $PODH_MODEL_ROOT"
    for d in "$PODH_MODEL_ROOT"/*/; do
        [ -d "$d" ] || continue
        echo "    $(basename "$d")  $(du -sh "$d" 2>/dev/null | cut -f1)"
    done
fi

echo
echo "[code source]  <- which code is ACTUALLY running"
# The deps-only doctrine means code arrives on the volume and shadows the baked copy via
# PYTHONPATH. When the sync did not happen, the pod runs the BAKED code and reports success
# — against the wrong thing. This block makes that visible instead of silent.
echo "  PYTHONPATH:  ${PYTHONPATH:-(unset)}"
if [ -d /workspace/code ]; then
    n=$(find /workspace/code -name "*.py" 2>/dev/null | wc -l | tr -d " ")
    echo "  /workspace/code: present, $n .py files"
else
    echo "  /workspace/code: ABSENT — the pod will run the BAKED code in /app."
    echo "                   If you expected synced code, the upload did not happen."
fi
python3 - <<'PYEOF' 2>/dev/null || echo "  (could not resolve runners package)"
try:
    import runners, os
    p = os.path.dirname(runners.__file__)
    print(f"  runners resolves to: {p}")
    print("  -> VOLUME code" if p.startswith("/workspace") else "  -> BAKED image code")
except Exception as e:
    print(f"  workload registry not importable yet: {type(e).__name__}")
PYEOF

echo
echo "[python]"
echo "  interpreter: $(command -v python3)"
echo "  version:     $(python3 --version 2>&1)"
python3 - <<'PY' 2>/dev/null || echo "  (package versions unavailable)"
# What is INSTALLED, not a checklist from one pipeline. This listed numpy, scipy, librosa,
# torch, torchaudio and speechbrain as "NOT INSTALLED" inside a slim image that was never
# meant to have them — which reads as a broken image dragging an audio stack around. The
# image was fine; the report was written for a different one.
import importlib.metadata as md
skip = {"pip", "setuptools", "wheel"}
names = sorted({(d.metadata["Name"] or "?") for d in md.distributions()},
               key=str.lower)
shown = [n for n in names if n.lower() not in skip]
print(f"  {len(shown)} packages")
for n in shown[:24]:
    try:
        print(f"  {n+':':24} {md.version(n)}")
    except Exception:
        pass
if len(shown) > 24:
    print(f"  … and {len(shown) - 24} more")
PY

echo
echo "[env]"
# Every PODH_* and workload variable that is actually SET. A fixed list printed
# "(unset)" for a dozen variables belonging to a pipeline this image may know nothing
# about, which reads like breakage.
env | grep -E "^(PODH_|LINGUA_|MFA_|MAX_)" | sort | while IFS='=' read -r k v; do
    case "$k" in
        *TOKEN*|*SECRET*|*KEY*|*PASSWORD*) echo "  $k=<set>" ;;
        *) echo "  $k=$v" ;;
    esac
done

echo "================================================================================"
