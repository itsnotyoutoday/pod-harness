#!/bin/bash
# podh-init — container ENTRYPOINT. Everything in this file happens regardless of
# what command the operator passes, so observability is a property of the IMAGE and not
# something a launcher can forget to switch on.
#
# It does four things, in this order, and the order matters:
#
#   1. Mirror PID-1 stdout/stderr into console.log BEFORE the first echo, so this
#      script's own output is captured too. This is the one file that holds the FULL
#      container output — bash echoes, python prints, subprocess noise, crash traces —
#      i.e. the same bytes RunPod's dashboard shows.
#
#   2. Seed the model symlinks. Baked weights live in /opt (see podh-seed-models for
#      why they cannot live under the volume mount). This wires them into the cache
#      paths the pipeline actually looks in.
#
#   3. Start the sidecars — Caddy (static log serving) and the /v1 API — in the
#      BACKGROUND and disowned, so they survive the workload crashing. That window
#      between "workload died" and "container exits" is exactly when you most want to
#      read the log, and it is the window plexus-init was built to keep open.
#
#   4. exec into the operator's command, so PID 1 becomes the workload and the pod
#      stops billing the moment the work is done.
#
# ## Why the log goes on the volume
#
# RunPod mounts the network volume at /workspace, so a log written there survives pod
# death AND is readable from S3 without the pod being alive. plexus wrote its console.log
# to the same path but lost it when the pod went; putting it under the mount is a strict
# improvement, and it is what lets the control plane answer /v1/jobs/{id}/log for a pod
# that no longer exists.
#
# ## Why logs are namespaced by pod id
#
# plexus used a flat /workspace/console.log, which is correct for one-pod-at-a-time and
# silently corrupting for a fleet — two pods sharing a volume interleave into one file.
# LOG_DIR is per-pod so a fleet is safe by construction.


# Any fatal problem in batch mode must NOT exit.
#
# An exiting container is restarted by the provider, and a restart hits the same problem
# and exits again — a boot loop that bills forever and produces nothing. Observed twice:
# once as eight complete reruns of a finished job, once as a pod failing to find its spec
# over and over.
#
# So a fatal error reports itself, asks to be terminated, and then holds the container
# open so the message survives long enough to be read. The reaper stops the billing;
# exiting only guarantees the problem repeats.
fatal() {
    echo "  ✗ $*"
    echo "    Idling rather than exiting — an exiting container is restarted by the"
    echo "    provider and fails identically, forever, while billing."
    python3 -c "from pod_harness import heartbeat; heartbeat.done()" 2>/dev/null || true
    while true; do sleep 300; done
}
set -e

: "${PODH_WORKSPACE:=/workspace}"
: "${RUNPOD_POD_ID:=local}"
: "${PODH_SERVE_API:=1}"
: "${PODH_API_PORT:=8010}"

# Everything a job produces lives under runs/<job_id>/ — see STRUCTURE.md. This used to be
# logs/<pod_id>/, which scattered one job's output across logs/, out/ and status/ and is no
# longer a legal root. Falling back to the pod id keeps a pod that was launched without a
# job id (a shell, a probe) from writing outside the structure.
: "${PODH_JOB_ID:=}"
RUN_ID="${PODH_JOB_ID:-pod_$RUNPOD_POD_ID}"
LOG_DIR="$PODH_WORKSPACE/runs/$RUN_ID"
mkdir -p "$LOG_DIR"
export PODH_LOG_DIR="$LOG_DIR"

CONSOLE="$LOG_DIR/console.log"
touch "$CONSOLE"

# Must precede every echo below, or this script's own banner is missing from the file
# that is supposed to hold everything.
exec > >(tee -a "$CONSOLE") 2>&1

echo "================================================================================"
echo "  podh-init  $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "  pod:      ${RUNPOD_POD_ID}"
echo "  log dir:  ${LOG_DIR}"
echo "  pid:      $$"
echo "================================================================================"

# -- 2. baked models ------------------------------------------------------------------
if [ -x /usr/local/bin/podh-seed-models ]; then
    /usr/local/bin/podh-seed-models || echo "  ! model seeding failed (continuing)"
fi

# -- 3. sidecars ----------------------------------------------------------------------
# BEFORE the mount, deliberately, and this ordering is the whole point of the sidecars.
#
# They used to start after it. That made the pod dark for the entire duration of the
# mount — minutes while an object mount fetches a working set — and permanently dark
# whenever the mount FAILED, because a failed mount lands in fatal()'s idle loop and the
# log server was still three steps away from starting. So the one situation where you
# most need to read the console was the one situation guaranteed to serve nothing, and
# from outside it is indistinguishable from a pod that never booted.
#
# Nothing here needs the mount. Caddy serves $PODH_WORKSPACE/runs, which is container
# disk; console.log is already being written to it by the tee above. Starting them first
# costs nothing and buys visibility into every subsequent step, including the failures.
if [ -x /usr/local/bin/caddy ] && [ -f /etc/caddy/Caddyfile ]; then
    if [ -z "${PODH_API_TOKEN:-}" ]; then
        echo "  ! PODH_API_TOKEN unset — Caddy will reject every request."
        echo "    Set it in the pod env, or the log endpoint is unreachable."
    fi
    PODH_LOG_ROOT="$PODH_WORKSPACE/runs" \
    /usr/local/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile \
        > "$LOG_DIR/caddy.log" 2>&1 &
    disown $! 2>/dev/null || true
    echo "  caddy    :8000 → root=$PODH_WORKSPACE/runs, /v1 → 127.0.0.1:$PODH_API_PORT"
else
    echo "  caddy    not installed — HTTP log endpoint disabled"
fi

# The API is optional because a pure batch pod does not need it: it is handed one job
# spec and exits. Long-lived dev and service pods set PODH_SERVE_API=1 (the default)
# and get the control surface.
if [ "$PODH_SERVE_API" = "1" ] && command -v uvicorn >/dev/null 2>&1; then
    uvicorn serve.api:app --host 127.0.0.1 --port "$PODH_API_PORT" \
        > "$LOG_DIR/api.log" 2>&1 &
    disown $! 2>/dev/null || true
    echo "  api      127.0.0.1:$PODH_API_PORT (uvicorn)"
else
    echo "  api      disabled (PODH_SERVE_API=$PODH_SERVE_API)"
fi

# -- 4. data view ----------------------------------------------------------------------
# The container is TOLD how its data arrives (PODH_MOUNT_KIND) and arranges it: a bind
# mount or network volume needs only verifying, FUSE needs mounting before anything can
# read a path, object mode defers to each job. Same image, three modes, chosen at start.
#
# A failure here is fatal on purpose. Continuing would run the job against an empty
# directory, and a stage that processes zero files can still report success — the failure
# mode this project's whole verification framework exists to prevent.
#
# Fatal, but now VISIBLE: the log server above is already serving, so the reason is
# readable over HTTP instead of dying with the pod.
if [ -x /usr/local/bin/podh-mount ]; then
    if ! /usr/local/bin/podh-mount; then
        fatal "data view could not be established. Set PODH_MOUNT_KIND=object for the strategy that needs no host capabilities."
    fi
fi

# Roots are resolved further down, AFTER the spec is on disk — see `apply_roots`.
#
# They were resolved here at first, and it silently could not work: with mount kind
# "object" the spec is an object, fetched during batch dispatch, which is later than this.
# So mount_roots() saw no spec, fell back to its default, and the fallback SUCCEEDED —
# reporting "applied 2 from the job spec" over a spec it had never read, while the job kept
# the image's baked paths. A fallback that cannot be distinguished from a real answer is
# worse than no fallback.

echo "  workload: $*"
echo "================================================================================"

# -- 4. hand off ----------------------------------------------------------------------
# exec replaces this shell, so PID 1 becomes the workload and the pod stops billing the
# moment the work is done.
#
# Three start modes, one image. An explicit command always wins; otherwise PODH_MODE
# decides. This is what lets a batch pod, a dev pod and a long-lived service be the same
# artifact configured differently, rather than three images that drift apart.
#
#   batch   run one job spec, exit. PODH_JOB_SPEC names it.
#   serve   idle and serve /v1. The dev pod, and the shape the v1 backend grows into.
#   shell   drop to bash, for interactive debugging.
: "${PODH_MODE:=serve}"

if [ "$#" -gt 0 ]; then
    exec "$@"
fi

case "$PODH_MODE" in
  batch)
    : "${PODH_JOB_SPEC:=}"
    if [ -z "$PODH_JOB_SPEC" ]; then
        fatal "PODH_MODE=batch needs PODH_JOB_SPEC=/path/to/spec.json"
    fi
    # Without a mounted volume the spec is an OBJECT, not a file. It was staged to the
    # store before the pod existed, and with mount kind "object" there is no /workspace to
    # find it under — the launcher hands over a key, and the harness fetches it.
    #
    # This previously just exited, which took the container with it, which made the
    # provider restart it, which failed identically. A boot loop that bills.
    if [ ! -f "$PODH_JOB_SPEC" ] && [ -n "${PODH_JOB_SPEC_KEY:-}" ]; then
        echo "  spec not on disk — fetching ${PODH_JOB_SPEC_KEY} from the store"
        mkdir -p "$(dirname "$PODH_JOB_SPEC")"
        if python3 -c "
import os, sys
from pod_harness.objectstore import get_storage
st = get_storage()
key = os.environ['PODH_JOB_SPEC_KEY']
open(os.environ['PODH_JOB_SPEC'], 'wb').write(
    st.client.get_object(Bucket=st.require().bucket, Key=key)['Body'].read())
print('  fetched', key)
"; then
            :
        else
            echo "  ✗ could not fetch the spec from ${PODH_JOB_SPEC_KEY}"
        fi
    fi
    if [ ! -f "$PODH_JOB_SPEC" ]; then
        fatal "job spec not found: $PODH_JOB_SPEC (and PODH_JOB_SPEC_KEY=${PODH_JOB_SPEC_KEY:-unset} did not yield one)"
    fi
    echo "  mode: batch — $PODH_JOB_SPEC"

    # Resolve the roots the spec declares, now that the spec is genuinely readable.
    #
    # This is the earliest correct point: the mount runs before the spec is fetched, so
    # resolving there read nothing and quietly returned defaults. Doing it here means the
    # workload's paths come from the job that is actually running.
    #
    # Sourced in THIS shell rather than exported by a child, because a child cannot set its
    # parent's environment — the reason the values were previously computed, printed and
    # then thrown away.
    if [ -x /usr/local/bin/podh-roots ]; then
        if python3 /usr/local/bin/podh-roots > /tmp/podh-roots.env 2>/tmp/podh-roots.err; then
            set -a
            . /tmp/podh-roots.env
            set +a
            echo "  roots:   $(grep -c '^export .*=' /tmp/podh-roots.env) export(s) from the spec"
            sed 's/^export /    /' /tmp/podh-roots.env
        else
            # Loud, not fatal. The workload may not need declared roots at all, but a
            # resolver that failed while the job expects paths is worth seeing in the log
            # rather than inferring later from a FileNotFoundError.
            echo "  ! roots could not be resolved — the workload will use baked defaults:"
            sed 's/^/    /' /tmp/podh-roots.err 2>/dev/null | tail -5
        fi
    fi

    # Materialise the working set for mount kinds that cannot do it at boot.
    #
    # Object mode has no mount, and what to pull is described by the spec — which in object
    # mode is itself an object, fetched moments ago. So podh-mount could not do this, and
    # nothing else did: ObjectMount.prepare() existed, was correct, and was called by
    # nothing. The manifest never landed. Three runs read that as a path bug, because a
    # correct path over a missing file and a wrong path raise the identical error.
    if [ -x /usr/local/bin/podh-prepare ]; then
        set +e
        python3 /usr/local/bin/podh-prepare
        prc=$?
        set -e
        if [ "$prc" -ne 0 ]; then
            fatal "could not materialise the job's working set (see prepare output above). Running anyway would start stages against absent inputs, and a stage that processes zero files can still report success."
        fi
    fi

    # Put the workload's code on the path BEFORE exec'ing the engine.
    #
    # serve/code.py does this for the API path, and batch mode used to bypass it entirely
    # — so the code sat on the volume exactly where it belonged while Python was never
    # told to look, and the job died with "No module named 'maintenance'" against a
    # sys.path of ['/app', '/app']. The hint in that error even said the code was probably
    # not synced. It was synced. Nothing read it.
    # Without a volume the CODE is an object too, exactly like the spec. Only the spec
    # was being fetched, so a volume-less pod got as far as knowing what to run and then
    # could not find the code to run it — and idled, correctly, having achieved nothing.
    # Rebuild the workload code this job pinned.
    #
    # The inline fetch this replaces listed an object prefix and downloaded one object per
    # file: 1.43s for 54 files measured against R2, extrapolating to ~22 minutes at 50,000
    # — every second of it billed. podh-code reads the job pointer, pulls ONE packed
    # object, and verifies the rebuild against the tree manifest. It falls back to the old
    # per-object layout so revisions published before the pack store stay launchable.
    if [ -n "${PODH_CODE_ROOT:-}" ] && [ ! -d "$PODH_CODE_ROOT" ]; then
        set +e
        python3 /usr/local/bin/podh-code
        crc=$?
        set -e
        if [ "$crc" -ne 0 ]; then
            fatal "could not rebuild the workload code (see above). Falling back to the image's baked code would run SOMETHING and report success against a source nobody chose."
        fi
    fi

    if [ -n "${PODH_CODE_ROOT:-}" ]; then
        if [ -d "$PODH_CODE_ROOT" ]; then
            export PYTHONPATH="$PODH_CODE_ROOT${PYTHONPATH:+:$PYTHONPATH}"
            echo "  code: $PODH_CODE_ROOT ($(find "$PODH_CODE_ROOT" -maxdepth 2 -name "*.py" 2>/dev/null | wc -l | tr -d " ") .py files)"
        else
            # Loud, and fatal. Falling back to the image's baked code would run SOMETHING
            # and report success against the wrong source, which is worse than stopping.
            fatal "PODH_CODE_ROOT=$PODH_CODE_ROOT does not exist on this mount. The loader published code there; either the mount is wrong or the spec names a prefix never written."
        fi
    fi

    [ -x /usr/local/bin/podh-preflight ] && /usr/local/bin/podh-preflight
    # The GENERIC engine, not a workload's module. This said runners.execute_job until a
    # pod spent 13 minutes proving the module no longer exists — the third time today a
    # Python move left this shell script pointing at the old location. The Dockerfile now
    # asserts this exact module imports, so the mismatch fails the BUILD instead.
    # NOT exec: the job must not be the container's last breath.
    #
    # A batch job that exits takes the container with it, and RunPod restarts a container
    # that exits — so a finished job runs again, and again. Observed: 18 boots, 8 complete
    # runs of the same benchmark, which would have continued until the budget or somebody
    # noticed. Billing eight times for one answer.
    # set +e around the job, and this is not a style choice.
    #
    # `set -e` is on for this whole script, so a job exiting non-zero killed podh-init
    # right here — before `rc=$?`, before the heartbeat, and before the idle loop below
    # that exists specifically to stop boot loops. The guard against restarting was
    # unreachable in the only case that triggers a restart: failure.
    #
    # The result was the exact loop the idle loop was written to prevent, and worse than
    # the original: 19 boots in five minutes, 58 identical acquire failures, still billing.
    # A failing job is precisely when the container must stay up to be read.
    set +e
    python3 -u -m "${PODH_ENTRY:-pod_harness.execute_job}" --spec "$PODH_JOB_SPEC"
    rc=$?
    set -e
    echo "  job finished (exit $rc)"

    # Make the outputs durable BEFORE reporting done.
    #
    # ObjectMount.publish() existed and was called by nothing — the same omission as
    # prepare(), with a worse consequence: a run completed all seven stages, reported ok
    # for each, exited 0, and published zero objects. Every output sat on the container
    # disk and died with the pod. Six minutes of successful compute, nothing that outlived
    # the machine, and a status that said done.
    #
    # Before the heartbeat, deliberately: done() asks the control plane to terminate this
    # pod, and terminating before the outputs are pushed destroys them.
    if [ -x /usr/local/bin/podh-publish ]; then
        set +e
        python3 /usr/local/bin/podh-publish
        prc=$?
        set -e
        if [ "$prc" -ne 0 ] && [ "$rc" -eq 0 ]; then
            # The job succeeded but its product did not survive. That is a FAILED run, and
            # calling it anything else is how a green status comes to mean nothing.
            rc=$prc
            echo "  ✗ job stages passed but publishing failed — treating the run as failed"
        fi
    fi

    # Ask to be terminated, and SAY whether it worked.
    #
    # This was `2>/dev/null || true` — the one call responsible for stopping the billing was
    # the one call whose failure was silenced. A finished pod then idled for 20 minutes at
    # $0.48/hr with nothing in the log to explain why, and the comment underneath claimed
    # the poll would catch it within a minute. It would not have: see below.
    set +e
    dmsg=$(python3 -c "
from pod_harness import heartbeat
r = heartbeat.done()
print('terminate requested' if r else 'NOT SENT — no control url or pod id')
" 2>&1)
    drc=$?
    set -e
    if [ "$drc" -eq 0 ]; then
        echo "  control: $dmsg"
    else
        echo "  ! control: could not request termination — $(echo "$dmsg" | tail -2 | tr '\n' ' ')"
        echo "    This pod will keep billing until the watchdog reaps it. Stopping the"
        echo "    heartbeat below is what lets that happen."
    fi

    # Stop heartbeating now that the work is done.
    #
    # The heartbeat thread ran for the container's whole life, so an idling FINISHED pod
    # kept reporting itself healthy — and the watchdog's primary signal is "was reporting,
    # went quiet". A pod that never goes quiet is never stuck, so the safety net could not
    # fire and the only remaining backstop was the 8-hour budget.
    #
    # Going quiet deliberately is what turns the watchdog from a formality into a bound:
    # if the terminate request above failed, the pod now looks stuck within
    # stale_after_sec and gets reaped for it.
    touch /tmp/podh-stop-heartbeat

    # Then hold the container open. Idling costs pennies a minute and is bounded by the
    # reaper; restarting costs a whole job every time and is bounded by nothing.
    #
    # "Bounded by the reaper" is only true because the heartbeat stopped above. While it
    # kept running, this loop was bounded by nothing except the budget.
    echo "  idling until terminated externally — an exiting container gets restarted,"
    echo "  which would run this job again from the top."
    while true; do sleep 300; done
    ;;

  serve)
    # Idle in the foreground. A pod is only "up" while its process runs: an image whose
    # command returns immediately leaves a pod that bills, reports no runtime and opens no
    # port — it looks broken in the console. See batch_pod.py on why this matters.
    echo "  mode: serve — idling. Drive this container through the /v1 API."
    exec tail -f /dev/null
    ;;

  shell)
    echo "  mode: shell"
    exec /bin/bash
    ;;

  *)
    fatal "unknown PODH_MODE=$PODH_MODE (want batch|serve|shell)"
    ;;
esac
