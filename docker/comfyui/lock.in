# Inputs to lock.txt: the union of what the two ComfyUI images install, so both resolve to
# ONE set of versions and the video image never moves a package the base image put there.
#
# Regenerate (resolution only, nothing is installed; torch resolves against PyPI's metadata,
# whose nvidia-*/cuda-*/triton lines are then dropped — the cu128 wheels bring their own):
#
#   uv pip compile docker/comfyui/lock.in --python-version 3.12 \
#       --python-platform x86_64-manylinux_2_28 --no-header --no-annotate \
#     | grep -Ev '^(nvidia-|cuda-|triton==)' \
#     | sed -E 's/^(torch|torchaudio)==(.*)$/\1==\2+cu128/; s/^torchvision==(.*)$/torchvision==\1+cu128/'
#
# then put the header of lock.txt back on. When a pin below moves, the Dockerfiles' pins move
# with it (they are checked against this file at build time).

# -- the torch trio and numpy: the ABI everything else is built against --------------------
torch==2.11.0
torchvision==0.26.0
torchaudio==2.11.0
numpy==2.5.4
# One cv2, three distribution names: packs ask for opencv-python, -headless and -contrib.
# All three at one version; contrib (the superset) is installed last so its files win.
opencv-python==4.14.0.94
opencv-python-headless==4.14.0.94
opencv-contrib-python==4.14.0.94
setuptools
cython

